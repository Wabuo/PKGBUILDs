#!/bin/sh
# Block pushes where any changed package has a stale or missing .SRCINFO.

zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # branch deletion, nothing to check
    [ "$local_sha" = "$zero" ] && continue

    if [ "$remote_sha" = "$zero" ]; then
        # new remote branch: check everything tracked
        git ls-files | "$(dirname "$0")/check-srcinfo" || status=1
    else
        git diff --name-only "$remote_sha" "$local_sha" | "$(dirname "$0")/check-srcinfo" || status=1
    fi
done

exit $status
